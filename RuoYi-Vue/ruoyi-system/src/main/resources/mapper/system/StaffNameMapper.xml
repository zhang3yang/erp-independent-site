<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.StaffNameMapper">

    <!--
      登录名 → 昵称。sys_user 在 sdssys 库，与业务表跨库同实例，限定库名即可。
      user_name 有唯一索引，一个登录名最多一行。
    -->
    <select id="selectNickNames" resultType="java.util.Map">
        select user_name as login, nick_name as name
          from sdssys.sys_user
         where user_name in
         <foreach collection="logins" item="login" open="(" separator="," close=")">#{login}</foreach>
    </select>

    <!--
      反向查：昵称模糊 → 登录名。给「按业务员名称搜订单」用。

      不过滤 del_flag：人离职了、账号被停用或删了，他名下的历史单据还在，
      还得按名字搜得到。与上面的 selectNickNames 同口径（那边也不过滤，
      查不到就回退显示登录名）。
    -->
    <select id="selectLoginsByNickNameLike" resultType="java.lang.String">
        select user_name
          from sdssys.sys_user
         where nick_name like concat('%', #{keyword}, '%')
    </select>

</mapper>
