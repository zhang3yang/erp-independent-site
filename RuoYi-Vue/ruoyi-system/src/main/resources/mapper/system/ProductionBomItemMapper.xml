<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ProductionBomItemMapper">
    <resultMap type="ProductionBomItem" id="ProductionBomItemResult">
        <result property="id" column="id" /><result property="shopCode" column="shop_code" />
        <result property="bomDetailCode" column="bom_detail_code" /><result property="bomCode" column="bom_code" />
        <result property="lineNo" column="line_no" /><result property="goodsCode" column="goods_code" />
        <result property="goodsName" column="goods_name" /><result property="spec" column="spec" />
        <result property="unit" column="unit" /><result property="qtyPerUnit" column="qty_per_unit" />
        <result property="remark" column="remark" />
    </resultMap>
    <sql id="columns">select id, shop_code, bomdetailcode as bom_detail_code, bomcode as bom_code,
        lineno as line_no, goodscode as goods_code, goodsname as goods_name, spec, unit,
        qtyperunit as qty_per_unit, remark
        from sdsshop.u_p_bomdetail</sql>
    <select id="selectByBomCode" resultMap="ProductionBomItemResult"><include refid="columns" />
        where shop_code = #{shopCode} and bomcode = #{bomCode} order by lineno</select>
    <insert id="batchInsert">
        insert into sdsshop.u_p_bomdetail
        (shop_code,bomdetailcode,bomcode,lineno,goodscode,goodsname,spec,unit,qtyperunit,remark)
        values <foreach item="item" collection="items" separator=",">(
            #{item.shopCode},#{item.bomDetailCode},#{item.bomCode},#{item.lineNo},#{item.goodsCode},
            #{item.goodsName},#{item.spec},#{item.unit},#{item.qtyPerUnit},#{item.remark})</foreach>
    </insert>
    <select id="countByGoodsCode" resultType="int">
        select count(1) from sdsshop.u_p_bomdetail
         where shop_code = #{shopCode} and goodscode = #{goodsCode}
    </select>
    <!-- 改配方一律先清后插：行数和顺序都可能变，逐行 diff 不划算 -->
    <delete id="deleteByBomCode">
        delete from sdsshop.u_p_bomdetail where shop_code = #{shopCode} and bomcode = #{bomCode}
    </delete>
</mapper>
