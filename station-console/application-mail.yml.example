# ============================================================================
# 询盘通知的邮件配置 —— 模板
# ============================================================================
#
# 用法：复制成同目录的 `application-mail.yml`（去掉 .example），填上真值。
#
#     生产：放在 jar 同一个目录（运维手册 docs/独立站部署手册（Windows）.md 阶段 8）
#     本地：放在 station-console/ 下，IDE 跑 StationConsoleApplication 时的工作目录
#
# `application-mail.yml` 在 .gitignore 里（根 .gitignore 第 46 行 `**/application-mail.yml`），
# 不会被提交。**这个 .example 文件里不要填真的账号密码。**
#
# ---------------------------------------------------------------------------
# ⚠ 为什么这些配置单独一个文件，而不是写在 application.yml 里
# ---------------------------------------------------------------------------
#
# 除了「密码不进版本库」之外，还有一个技术原因：Spring Boot 判断「要不要建
# JavaMailSender」看的是 `spring.mail.host` 这个属性**存不存在**，不看它是不是空串。
# 在 application.yml 里写 `host: ${MAIL_HOST:}`，环境变量没设时得到的是空串——
# 属性存在，Boot 就建出一个 host="" 的发信器，然后每次启动都报一条
# 「配了 SMTP 但没有发件人」。
#
# 挪成一个可选导入的文件之后，不配它 = 属性真的不存在 = 不建 bean，
# 启动日志是 INFO「未配置 SMTP，收到询盘只入库不发信」——不发信的部署就该是这个状态。
#
# ---------------------------------------------------------------------------
# 还有一半不在这个文件里
# ---------------------------------------------------------------------------
#
# 这里配的是**发件人**。**收件人**在站点档案里：`u_s_siteinfo.notifyemail`
# （管理台「站点设置 → 询盘通知邮箱」，多个用逗号隔开）。留空则不发信。
# 两处都要有，缺一处就是「配了但没收到」。
# ============================================================================

spring:
  mail:
    # 腾讯企业邮 smtp.exmail.qq.com / 阿里云企业邮 smtp.qiye.aliyun.com
    # QQ 个人邮箱 smtp.qq.com（先跑通链路时用，正式对外换企业邮）
    host: smtp.example.com
    # 465 = SSL。587（STARTTLS）也支持，但 465 在国内网络下更稳
    port: 465
    username: "CHANGE_ME_BEFORE_RUNNING"
    # ⚠ 是邮箱的「授权码 / 客户端专用密码」，不是登录密码。
    #   泄露等于别人能用这个邮箱发信——这个文件不要发群里、不要提交。
    password: "CHANGE_ME_BEFORE_RUNNING"
    default-encoding: UTF-8
    properties:
      mail:
        smtp:
          auth: true
          ssl:
            enable: true
          # 三个超时都要设。不设的话 SMTP 连不上会一直挂着，
          # 占着 InquiryNotifier 那个发信线程池的位置
          connectiontimeout: 5000
          timeout: 5000
          writetimeout: 5000

station:
  # 发件人地址。留空则回退到 spring.mail.username。
  #
  # ⚠ QQ / 企业邮都不允许伪造发件人：这里填的地址和 username 不一致会被拒（501 / 553）。
  #   所以除非你确实有多地址发信权限，就填成和 username 一样。
  notify-from: notice@example.com

console:
  # 通知邮件正文里那个「去处理」链接，指向**本站管理台**的地址。
  #
  # ⚠ 和 ERP 时代不一样了：那时候管理台没有登录页、唯一入口是从 ERP 点进来，
  #   所以那个链接必须填 ERP 的地址。现在管理台有自己的登录页（boundary §6a），
  #   直接填管理台自己的地址就行，商家点进去是登录页。
  #
  # 留空则邮件里不放链接。
  home-url: https://console.example.com
